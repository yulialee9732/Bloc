rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/blocks/{blockId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'icon', 'color', 'duration', 'dailyGoal', 'order'])
        && request.resource.data.duration is int
        && request.resource.data.dailyGoal is int
        && request.resource.data.duration > 0
        && request.resource.data.dailyGoal >= 0;
    }

    match /users/{userId}/sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['blockId', 'date', 'elapsed', 'completed'])
        && request.resource.data.elapsed is int
        && request.resource.data.elapsed >= 0;
    }

    match /users/{userId}/habits/{date} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/streaks/{blockId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/timerState/{blockId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/stats/{month} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/aiAnalysis/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/plans/{weekId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/meta/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
